# Copy to .env and fill in by hand. Never paste a key into a chat or an agent session.
# .env is gitignored.

# Deployer key for Base mainnet. Needs a small amount of ETH for gas plus Inco fees.
# The day 1 smoke test costs roughly 0.00002 ETH in Inco fees plus gas.
PRIVATE_KEY=

# Required in practice. Use the Alchemy Base mainnet URL.
# Do not point this at https://mainnet.base.org: it throttles silently and caches
# failures for 24 hours. publicnode is wired in as the single fallback behind this.
# Note for anything reading logs: Alchemy free tier caps eth_getLogs at 10-block
# windows, so chunk requests accordingly.
BASE_RPC_URL=

# Optional. Set to reuse an already deployed IncoSmoke instead of paying deploy gas.
SMOKE_ADDRESS=
