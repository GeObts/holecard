# Copy to .env and fill in by hand. Never paste a key into a chat or an agent session.
# .env is gitignored.

# Deployer key for Base mainnet. Needs a small amount of ETH for gas plus Inco fees.
# The day 1 smoke test costs roughly 0.00002 ETH in Inco fees plus gas.
PRIVATE_KEY=

# Optional. Defaults to the public endpoint, which is rate limited.
BASE_RPC_URL=https://mainnet.base.org
